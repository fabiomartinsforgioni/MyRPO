# Preencher por ambiente com dados do banco autorizado. O psql usa estas variáveis.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGSSLMODE=verify-full
PGSSLROOTCERT=
# Fornecer a senha pelo mecanismo de segredos do ambiente.

# Configuração de execução no Render. Preencher os segredos no painel do serviço.
MYRPO_MODE=POSTGRES
MYRPO_ORIGIN=
MYRPO_DATABASE_URL=
MYRPO_CSRF_KEY=
